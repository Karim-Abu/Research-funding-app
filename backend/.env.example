# Backend configuration — names only, never commit real secrets.
# Copy to backend/.env for local development.

# SQLite database (relative to the backend/ working directory).
DATABASE_URL=sqlite:///./app.db
APP_ENV=development
DEMO_DATA_ENABLED=false

# Session cookie / CSRF.
SESSION_COOKIE_NAME=rf_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Origin allow-list for unsafe-method CSRF/Origin validation (JSON array).
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Pre-provisioned dev users (no self-sign-up). Override in any real deployment.
SEED_LEAD_ADMIN_EMAIL=anna.keller@example.test
SEED_LEAD_ADMIN_PASSWORD=changeme-dev-lead
SEED_MEMBER_EMAIL=tobias.frei@example.test
SEED_MEMBER_PASSWORD=changeme-dev-member

LOG_LEVEL=INFO

# --- KI-Provider (R4.3 ProviderPolicy — docs/security/provider-policy.md) -----
# Fake/local ist der Default für Tests und Demo. Ohne Keys sind reale Routen
# schlicht nicht verfügbar (kein Crash). Die ProviderPolicy blockiert direkte
# Consumer-APIs für echte D1/D2-Daten UNABHÄNGIG von gesetzten Keys;
# D3/Unknown sind für jeden Provider blockiert — auch für den Fake.
AGENT_FAKE_PROVIDER=true
# Azure ist der dokumentierte Zielpfad, aber im Backend noch nicht als aktiver
# Adapter freigeschaltet. Diese Werte bedienen aktuell z.B. den Azure-Smoke-Test
# und koennen fuer den spaeteren Azure-Adapter wiederverwendet werden.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# "real" erlaubt direkte APIs ausschliesslich für synthetische/anonymisierte
# Evaluationsfälle (F1 synthetic) und gilt als dokumentierte Owner-Freigabe.
AI_EVAL_MODE=off
# Logische Kandidaten-Aliase werden erst hier auf konkrete Provider-IDs
# aufgelöst. Leer = Route nicht verfügbar; es wird keine ID geraten.
AGENT_MODEL_GPT_56_LUNA_ID=
AGENT_MODEL_GPT_56_TERRA_ID=
AGENT_MODEL_GPT_56_SOL_ID=
AGENT_MODEL_CLAUDE_HAIKU_45_ID=
AGENT_MODEL_CLAUDE_SONNET_5_ID=
AGENT_MODEL_CLAUDE_FABLE_5_ID=
# Nur versionierte, deploymentseitig geprüfte CHF-Preise eintragen:
# {"provider-model-id":{"input_chf_per_million":0,"output_chf_per_million":0,
# "price_version":"YYYY-MM-DD.v1","source_url":"https://...","checked_at":"YYYY-MM-DD"}}
AGENT_MODEL_PRICING_CHF_PER_MILLION={}
AGENT_QUALITY_CEILING_ENABLED=false
PROVIDER_PREFLIGHT_TTL_SECONDS=21600

# --- Webresearch (M9I-A/M9J; eigener Fake-Schalter) ---------------------------
WEB_RESEARCH_ENABLED=false
WEB_RESEARCH_FAKE_PROVIDER=false
FIRECRAWL_API_KEY=
D2_WEB_RESEARCH_ENABLED=false

# Hinweis: Provider-Keys gehören NUR hierher (Server) — niemals in eine
# NEXT_PUBLIC_*-Variable (würde im Browser landen).
