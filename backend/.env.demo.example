# Demo-Konfiguration zum reinen Kopieren — keine echten Schlüssel, keine
# externen Aufrufe. Fertige Werte für den lokalen Demo-Betrieb:
#
#     Copy-Item backend\.env.demo.example backend\.env
#
# Danach ist nichts mehr zu bearbeiten. Wer stattdessen reale Provider
# einrichten will, kopiert backend\.env.example und liest
# docs\demo\live-ai-firecrawl-setup.md.

# --- Datenbank und Betriebsart -----------------------------------------------
# Der Pfad ist relativ zum Ordner backend\ — das Backend muss von dort
# gestartet werden. Die Datei wird beim ersten Migrationslauf angelegt.
DATABASE_URL=sqlite:///./var/demo.db
APP_ENV=development
DEMO_DATA_ENABLED=true
LOG_LEVEL=INFO

# --- Demo-Generator statt echter KI ------------------------------------------
# AGENT_FAKE_PROVIDER erzeugt reproduzierbare, in der Oberfläche als
# «Demo-Vorschlag (kein echtes KI-Modell)» gekennzeichnete Texte.
# WEB_RESEARCH_FAKE_PROVIDER liefert Demo-Rechercheergebnisse; es wird keine
# Webseite abgerufen. AI_EVAL_MODE=off sperrt den realen Auswertungspfad.
AGENT_FAKE_PROVIDER=true
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_FAKE_PROVIDER=true
D2_WEB_RESEARCH_ENABLED=false
AI_EVAL_MODE=off

# --- Provider-Schlüssel: bewusst leer ----------------------------------------
# Ohne Schlüssel sind reale Provider-Routen schlicht nicht verfügbar. Das ist
# kein Fehler und führt zu keinem Absturz. Schlüssel gehören ausschliesslich
# hierher (Server) — niemals in eine NEXT_PUBLIC_*-Variable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Sitzung und erlaubte Browser-Adressen -----------------------------------
SESSION_COOKIE_NAME=rf_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Lokale Anmeldedaten der Demo --------------------------------------------
# Es gibt keine Selbstregistrierung. Diese zwei Konten legt der Seed an.
# Nur für die lokale Demo gedacht — in jeder echten Umgebung ersetzen.
SEED_LEAD_ADMIN_EMAIL=anna.keller@example.test
SEED_LEAD_ADMIN_PASSWORD=changeme-dev-lead
SEED_MEMBER_EMAIL=tobias.frei@example.test
SEED_MEMBER_PASSWORD=changeme-dev-member
