# Server-seitige Konfiguration (nur Namen, keine echten Werte committen).
# Vorlage zum reinen Kopieren — für den lokalen Betrieb ist nichts zu ändern:
#
#     Copy-Item .env.example .env.local
#
# Betriebsart der Oberfläche. Nur der Wert "live" spricht mit dem lokal
# gestarteten Python-Backend. Jeder andere Wert — auch eine fehlende Zeile —
# lässt die Oberfläche ohne Fehlermeldung mit erfundenen Beispieldaten im
# Browser laufen (Mock-Modus). "live" bedeutet nicht "externe KI".
APP_BACKEND_MODE=live

# Basis-URL der FastAPI-Bridge zum Python-Backend (research-funding-mvp).
# Wird ausschliesslich von den Route-Handlern unter app/api/* gelesen.
FASTAPI_BRIDGE_URL=http://127.0.0.1:8000/api/v1

# Hinweis (R4.3): KI-Provider-Keys gehören ausschliesslich in backend/.env
# (siehe backend/.env.example) — niemals als NEXT_PUBLIC_*-Variable, diese
# würden im Browser landen. Ein Test erzwingt das (test_provider_policy.py).
